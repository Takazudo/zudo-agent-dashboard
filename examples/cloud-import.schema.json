{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zudo cloud observation import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "events": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "run_id", "machine", "source", "kind", "observed_at"],
        "properties": {
          "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "machine": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "run_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source": {"const": "cloud-import"},
          "kind": {"enum": ["discovered", "session-start", "working", "permission-request", "turn-stop", "error-observed", "session-end", "interrupted", "unknown", "completed"]},
          "observed_at": {"type": "number", "minimum": 0, "description": "Finite Unix seconds; runtime rejects >60 seconds in future. Preserve on replay."}
        }
      }
    }
  }
}
